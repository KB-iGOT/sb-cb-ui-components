{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {

    "experimentalDecorators": true,
    "outDir": "../../../out-tsc/lib",
    "declarationMap": true,
    "declaration": true,
    "inlineSources": true,
    "types": [],
    "lib": [
      "dom",
      "es2018"
    ]
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "strictInjectionParameters": true,
    "enableIvy": true
  },
  "exclude": [
    "src/test.ts",
    "**/*.spec.ts"
  ]
}
