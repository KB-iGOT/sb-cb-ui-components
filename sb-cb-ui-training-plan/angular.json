{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "sunbird-cb-training-plan": {
      "projectType": "library",
      "root": "library/sunbird-cb/training-plan",
      "sourceRoot": "library/sunbird-cb/training-plan/src",
      "prefix": "sb-tp",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "library/sunbird-cb/training-plan/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "library/sunbird-cb/training-plan/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "library/sunbird-cb/training-plan/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "library/sunbird-cb/training-plan/src/test.ts",
            "tsConfig": "library/sunbird-cb/training-plan/tsconfig.spec.json",
            "karmaConfig": "library/sunbird-cb/training-plan/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "library/sunbird-cb/training-plan/**/*.ts",
              "library/sunbird-cb/training-plan/**/*.html"
            ]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "cli": {
    "analytics": "ed11d5a4-411f-49e8-b228-59596e35616e",
    "cache": {
      "enabled": false
    }
  }
}