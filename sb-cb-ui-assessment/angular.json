{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "project",
  "projects": {
    "@sunbird-cb/assessment": {
      "projectType": "library",
      "root": "library/sunbird-cb/assessment",
      "sourceRoot": "library/sunbird-cb/assessment/src",
      "prefix": "",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "library/sunbird-cb/assessment/tsconfig.lib.json",
            "project": "library/sunbird-cb/assessment/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "library/sunbird-cb/assessment/tsconfig.lib.prod.json"
            }
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "library/sunbird-cb/assessment/src/test.ts",
            "tsConfig": "library/sunbird-cb/assessment/tsconfig.spec.json",
            "karmaConfig": "library/sunbird-cb/assessment/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "library/sunbird-cb/assessment/**/*.ts",
              "library/sunbird-cb/assessment/**/*.html"
            ],
            "eslintConfig": "library/sunbird-cb/assessment/eslint.config.js"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": [
      "angular-eslint"
    ]
  }
}
