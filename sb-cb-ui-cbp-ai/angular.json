{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "cbp-ai": {
      "projectType": "library",
      "root": "library/sunbird-cb/cbp-ai",
      "sourceRoot": "library/sunbird-cb/cbp-ai/src",
      "prefix": "sb-uic",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "library/sunbird-cb/cbp-ai/tsconfig.lib.json",
            "project": "library/sunbird-cb/cbp-ai/ng-package.json"
          }
        ,          "configurations": {
            "production": {
              "tsConfig": "library/sunbird-cb/cbp-ai/tsconfig.lib.prod.json"
            }
          }
},
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "library/sunbird-cb/cbp-ai/src/test.ts",
            "tsConfig": "library/sunbird-cb/cbp-ai/tsconfig.spec.json",
            "karmaConfig": "library/sunbird-cb/cbp-ai/karma.conf.js"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "cli": {
    "analytics": "ed11d5a4-411f-49e8-b228-59596e35616e",
    "cache": {
      "enabled": false
    }
  }
}